      retries: 10

  backup:
    image: zaico/app:latest
    build:
      context: .
      dockerfile: Dockerfile
    profiles: ["backup"]
    env_file: .env
    environment:
      DB_CONNECTION: pgsql
      DB_HOST: db
      DB_PORT: 5432
      RUN_MIGRATIONS: "false"
    entrypoint: ["/bin/bash", "/var/www/html/docker/backup.sh"]
    depends_on:
      db:
        condition: service_healthy
    volumes:
      - backups:/backups

volumes:
  storage:
  dbdata:
  backups:
</file>

