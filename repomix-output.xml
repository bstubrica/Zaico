        $respuesta->assertSessionHasNoErrors();
        $this->assertDatabaseHas('ACTIVOS', ['Etiqueta_activo' => 'TBMAC0001', 'Direccion_MAC' => '00:11:22:33:44:55']);
    }

    public function test_rechaza_una_direccion_mac_invalida(): void
