APP_NAME=Zaico
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Zaico: registro de usuarios ---
# Sistema interno: el autorregistro público está deshabilitado por defecto.
# Si se habilita, las cuentas nuevas reciben el rol indicado (mínimo privilegio).
ZAICO_REGISTRO_PUBLICO=false
ZAICO_REGISTRO_ROLE=Auditor

# --- Zaico: alertas de inventario (Fase 8) ---
ZAICO_REPARACION_DIAS=15
ZAICO_GARANTIA_DIAS=30

# --- Zaico: sincronización Snipec IT (Fase 10) ---
# Carpeta donde se deja el CSV; vacío usa storage/app/snipec
ZAICO_SNIPEC_DIR=
ZAICO_SNIPEC_PATRON=custom-assets-report-*.csv
# Usuario (email o id) que firma la importación automática; vacío usa el primer Admin
ZAICO_SNIPEC_USUARIO=

# --- Zaico: depuración total del inventario (Administración) ---
# Módulo de emergencia solo para Admin que borra físicamente los datos de
# inventario (conserva usuarios y catálogo de estados). La contraseña se guarda
# como hash bcrypt:
#   php artisan tinker --execute 'echo Hash::make("tu-contraseña");'
# Si el hash queda vacío, el módulo no puede ejecutarse.
ZAICO_DEPURACION_PASSWORD_HASH=
# Frase exacta que el administrador debe escribir para confirmar la operación.
ZAICO_DEPURACION_FRASE="BORRAR TODO EL INVENTARIO"
# En producción el módulo se bloquea salvo que se habilite explícitamente.
ZAICO_DEPURACION_HABILITADO=false

# Producción (docker-compose):
# DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=Zaico
# DB_USERNAME=zaico
# DB_PASSWORD=cambiar-en-produccion
#
# Endurecimiento recomendado en producción:
# APP_ENV=production
# APP_DEBUG=false            # nunca exponer stack traces
# LOG_LEVEL=warning
# SESSION_ENCRYPT=true       # cifrar el payload de la sesión
# SESSION_SECURE_COOKIE=true # cookie solo por HTTPS
# SESSION_SAME_SITE=lax
# ZAICO_REGISTRO_PUBLICO=false
#
# Requiere servir el sitio detrás de HTTPS y ejecutar `php artisan config:cache route:cache view:cache`.

